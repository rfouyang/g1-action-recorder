# Copy to .env (git ignores it). Everything works without it; each speech key turns on its Speech page.

# Speech: BytePlus (Seed TTS 2.0) and MiniMax (T2A v2)
BYTEPLUS_API_KEY=
MINIMAX_API_KEY=

# Optional: other endpoints
# BYTEPLUS_API_BASE_URL=https://voice.ap-southeast-1.bytepluses.com
# BYTEPLUS_TTS_RESOURCE_ID=seed-tts-2.0
# MINIMAX_API_BASE_URL=https://api.minimax.io

# Optional: ports, bind addresses and data folder
# G1_RECORDER_HOST=127.0.0.1         # use 0.0.0.0 in Docker / Kubernetes
# G1_RECORDER_PORT=8000              # the page and the API
# G1_RECORDER_VISER_HOST=127.0.0.1
# G1_RECORDER_VISER_PORT=8001        # the robot's 3D view
# G1_RECORDER_MAP_VISER_HOST=127.0.0.1
# G1_RECORDER_MAP_VISER_PORT=8002    # the map's 3D view
# G1_RECORDER_DATA_DIR=./data        # poses, actions, speech clips and samples, maps
# VISER_PUBLIC_URL=                  # browser origin when Viser has its own Ingress host
# MAP_VISER_PUBLIC_URL=              # same for the map Viser
